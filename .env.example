# All credentials are optional: every module must import and the test suite must
# pass with no .env present. Config is pydantic-settings with the ESP_ prefix.

# Mailchimp (source seeding only, RC1-543). Key format embeds the server prefix
# after the dash, e.g. "abc123...-us21".
ESP_MAILCHIMP_API_KEY=

# Anthropic (discovery-report narration, RC1-544). Optional: the report
# renders without the narrated summary when unset.
ESP_ANTHROPIC_API_KEY=
# ESP_ANTHROPIC_MODEL=claude-opus-5-5

# Datadog (CI Test Optimization, LLM Obs tracing, run metrics - RC1-548).
# Read from the PROCESS environment, not this file: telemetry is decoration
# and declines quietly without it. Export DD_API_KEY in the shell (or
# ~/.zshrc) on a machine whose runs should trace; also `uv sync --group obs`
# to install ddtrace. DD_SITE defaults to datadoghq.com, DD_ENV to prod, and
# DD_VERSION to the pyproject version (the tag LLM Obs indexes root spans by).
# DD_API_KEY=

# Listmonk dev target (executor, RC1-546). Local docker-compose demo only:
# bring it up with `docker compose up -d`, then create the API user with
# `uv run python -m executor.bootstrap --export`. Tests read these from the
# process environment only, never from this file.
ESP_LISTMONK_URL=
ESP_LISTMONK_USERNAME=
ESP_LISTMONK_PASSWORD=

# Brevo live-demo target (RC1-547, ADR-0002). Free-tier API key; the adapter
# only creates contacts, lists, attributes, and DRAFT campaigns - nothing
# sends. The gated integration test reads this from the process env only.
ESP_BREVO_API_KEY=
