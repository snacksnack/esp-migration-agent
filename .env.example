# All credentials are optional: every module must import and the test suite must
# pass with no .env present. Config is pydantic-settings with the ESP_ prefix.

# Mailchimp (source seeding only, RC1-543). Key format embeds the server prefix
# after the dash, e.g. "abc123...-us21".
ESP_MAILCHIMP_API_KEY=

# Anthropic (discovery-report narration, RC1-544). Optional: the report
# renders without the narrated summary when unset.
ESP_ANTHROPIC_API_KEY=
# ESP_ANTHROPIC_MODEL=claude-opus-5-5

# Datadog (CI Test Optimization + later LLM Obs, RC1-548). Set as a repo
# Actions secret, not usually needed locally.
# DD_API_KEY=
