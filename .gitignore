__pycache__/
*.pyc
.venv/
.env
# Every dotted .env variant, so a new one cannot be added without also being
# ignored - .env.neon and .env.neon.owner each had to be listed by hand, and
# RC1-617 adds .env.listmonk. The example file is the one exception.
.env.*
!.env.example
.coverage
htmlcov/
.pytest_cache/
.ruff_cache/
dist/
node_modules/
.review_audit.jsonl

# Editor swap/backup files: a vim swap for .env.neon was committed once
# (RC1-581) and carried live credentials into a public repo. The .env rules
# above do not match them, so match them by shape.
*.swp
*.swo
*.swn
*~
.*.sw[a-p]
