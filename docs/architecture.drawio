        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;ESP Migration Agent — system view&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="250" y="0" width="520" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Trust boundary: the LLM proposes, deterministic Python validates, a human approves. The model never touches the source or the target." style="text;html=1;align=right;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="790" y="0" width="800" height="30" as="geometry" />
        </mxCell>

        <!-- Trust zones -->
        <mxCell id="zoneL" value="LLM proposes — claude-opus-5-5 via the Anthropic API (no write path, no decisions)" style="rounded=1;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;fontSize=13;fontStyle=1;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="430" y="40" width="620" height="150" as="geometry" />
        </mxCell>
        <mxCell id="zoneP" value="Deterministic Python validates — every number computed; the schema keeps bad states unrepresentable&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;i&gt;runs as a local CLI (uv run) on the operator&amp;#39;s workstation — no hosted service anywhere in the pipeline&lt;/i&gt;&lt;/font&gt;" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontSize=13;fontStyle=1;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="250" y="250" width="1140" height="220" as="geometry" />
        </mxCell>
        <mxCell id="zoneH" value="Human approves — nothing downstream runs without sign-off" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontSize=13;fontStyle=1;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="250" y="530" width="1140" height="150" as="geometry" />
        </mxCell>
        <mxCell id="zoneO" value="Telemetry &amp;amp; evals — Datadog (SaaS) + eval store (Heroku Postgres)" style="rounded=1;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontSize=13;fontStyle=1;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="250" y="740" width="1340" height="160" as="geometry" />
